<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="alarm_01">
    <static>true</static>

    <!-- Alarm housing -->
    <link name="base_link">
      <!-- Box housing -->
      <visual name="housing_visual">
        <geometry>
          <box><size>0.15 0.15 0.25</size></box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.4 0.4 0.4 1</diffuse>
        </material>
      </visual>
      <collision name="housing_collision">
        <geometry>
          <box><size>0.15 0.15 0.25</size></box>
        </geometry>
      </collision>

      <!-- Lens dome on top -->
      <visual name="lens_visual">
        <pose>0 0 0.175 0 0 0</pose>
        <geometry>
          <sphere><radius>0.06</radius></sphere>
        </geometry>
        <material>
          <ambient>0.4 0.05 0.05 1</ambient>
          <diffuse>0.6 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Fix to world -->
    <joint name="frame_fix" type="fixed">
      <parent>world</parent>
      <child>base_link</child>
    </joint>

    <!-- Alarm Plugin: flashes lens_visual color between red and dark -->
    <plugin filename="AlarmPlugin" name="syncai::AlarmPlugin">
      <link_name>base_link</link_name>
      <visual_name>lens_visual</visual_name>
      <flash_period>1.0</flash_period>
      <detection_range>3.0</detection_range>
    </plugin>

  </model>
</sdf>
