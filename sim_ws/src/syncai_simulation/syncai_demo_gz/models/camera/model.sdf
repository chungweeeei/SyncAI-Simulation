<sdf version="1.8">
  <model name="camera_01">
    <static>true</static>

    <!-- Camera body -->
    <link name="camera_body">
      <visual name="body_visual">
        <geometry>
          <box><size>0.15 0.1 0.1</size></box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <collision name="body_collision">
        <geometry>
          <box><size>0.15 0.1 0.1</size></box>
        </geometry>
      </collision>

      <sensor name="camera_sensor" type="camera">
        <topic>/camera</topic>
        <update_rate>15</update_rate>
        <camera>
          <horizontal_fov>1.39626</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>50.0</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>

    <!-- Mounting bracket -->
    <link name="mount_bracket">
      <pose>-0.1 0 0.05 0 0 0</pose>
      <visual name="bracket_visual">
        <geometry>
          <box><size>0.05 0.06 0.1</size></box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.25 0.25 0.25 1</diffuse>
        </material>
      </visual>
      <collision name="bracket_collision">
        <geometry>
          <box><size>0.05 0.06 0.1</size></box>
        </geometry>
      </collision>
    </link>

    <joint name="bracket_joint" type="fixed">
      <parent>camera_body</parent>
      <child>mount_bracket</child>
    </joint>
  </model>
</sdf>
