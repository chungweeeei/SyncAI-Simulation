<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="door_01">
    <static>false</static>

    <!-- Door frame (fixed structure) -->
    <link name="frame">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>100.0</mass>
      </inertial>

      <!-- Left pillar -->
      <visual name="left_pillar_visual">
        <pose>0 -1.3 1.1 0 0 0</pose>
        <geometry>
          <box><size>0.1 0.1 2.2</size></box>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.6 0.6 0.6 1</diffuse>
        </material>
      </visual>
      <collision name="left_pillar_collision">
        <pose>0 -1.3 1.1 0 0 0</pose>
        <geometry>
          <box><size>0.1 0.1 2.2</size></box>
        </geometry>
      </collision>

      <!-- Right pillar -->
      <visual name="right_pillar_visual">
        <pose>0 1.3 1.1 0 0 0</pose>
        <geometry>
          <box><size>0.1 0.1 2.2</size></box>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.6 0.6 0.6 1</diffuse>
        </material>
      </visual>
      <collision name="right_pillar_collision">
        <pose>0 1.3 1.1 0 0 0</pose>
        <geometry>
          <box><size>0.1 0.1 2.2</size></box>
        </geometry>
      </collision>

      <!-- Top beam -->
      <visual name="top_beam_visual">
        <pose>0 0 2.25 0 0 0</pose>
        <geometry>
          <box><size>0.1 2.7 0.1</size></box>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.6 0.6 0.6 1</diffuse>
        </material>
      </visual>
      <collision name="top_beam_collision">
        <pose>0 0 2.25 0 0 0</pose>
        <geometry>
          <box><size>0.1 2.7 0.1</size></box>
        </geometry>
      </collision>
    </link>

    <!-- Left door panel (slides in -Y direction to open) -->
    <link name="left_panel">
      <pose>0 -0.625 1.05 0 0 0</pose>
      <inertial>
        <mass>10.0</mass>
        <inertia>
          <ixx>4.98</ixx> <iyy>3.68</iyy> <izz>1.30</izz>
          <ixy>0</ixy> <ixz>0</ixz> <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="left_panel_visual">
        <geometry>
          <box><size>0.05 1.25 2.1</size></box>
        </geometry>
        <material>
          <ambient>0.3 0.5 0.7 1</ambient>
          <diffuse>0.4 0.6 0.8 1</diffuse>
        </material>
      </visual>
      <collision name="left_panel_collision">
        <geometry>
          <box><size>0.05 1.25 2.1</size></box>
        </geometry>
      </collision>
    </link>

    <!-- Right door panel (slides in +Y direction to open) -->
    <link name="right_panel">
      <pose>0 0.625 1.05 0 0 0</pose>
      <inertial>
        <mass>10.0</mass>
        <inertia>
          <ixx>4.98</ixx> <iyy>3.68</iyy> <izz>1.30</izz>
          <ixy>0</ixy> <ixz>0</ixz> <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="right_panel_visual">
        <geometry>
          <box><size>0.05 1.25 2.1</size></box>
        </geometry>
        <material>
          <ambient>0.3 0.5 0.7 1</ambient>
          <diffuse>0.4 0.6 0.8 1</diffuse>
        </material>
      </visual>
      <collision name="right_panel_collision">
        <geometry>
          <box><size>0.05 1.25 2.1</size></box>
        </geometry>
      </collision>
    </link>

    <!-- Fix frame to world -->
    <joint name="frame_fix" type="fixed">
      <parent>world</parent>
      <child>frame</child>
    </joint>

    <!-- Left panel: prismatic joint sliding along Y axis -->
    <joint name="left_door_joint" type="prismatic">
      <parent>frame</parent>
      <child>left_panel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.25</lower>
          <upper>0</upper>
        </limit>
        <dynamics>
          <damping>10.0</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- Right panel: prismatic joint sliding along Y axis -->
    <joint name="right_door_joint" type="prismatic">
      <parent>frame</parent>
      <child>right_panel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>1.25</upper>
        </limit>
        <dynamics>
          <damping>10.0</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- Sliding Door Plugin -->
    <plugin filename="DoorPlugin" name="syncai::DoorPlugin">
      <left_joint>left_door_joint</left_joint>
      <right_joint>right_door_joint</right_joint>
      <slide_distance>1.25</slide_distance>
      <speed>0.5</speed>
    </plugin>

  </model>
</sdf>
