POST http://localhost:3000/api/v1/commands
Content-Type: application/json

{
    "deviceId": "",
    "command": "write_coil",
    "timeoutSec": 30,
    "modbus": {
        "server": "localhost:5020",
        "unitId": 1,
        "address": 0,
        "value": true
    }
}

