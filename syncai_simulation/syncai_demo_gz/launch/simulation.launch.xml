<?xml version="1.0"?>

<launch>
  <arg name="gazebo_version" default='8'/>
  <arg name="sim_update_rate" default='100'/>
  <arg name="world" default="$(find-pkg-share syncai_demo_gz)/world/dp1f.world"/>
  <arg name="gui" default="true"/>
  <arg name="headless" default="false"/>

  <set_env name="GZ_SIM_RESOURCE_PATH" 
           value="$(find-pkg-share syncai_demo_gz)/.."/>

  <!-- Set use_sim_time for all nodes -->
  <set_parameter name="use_sim_time" value="true"/>

  <!-- Launch Gazebo simulator -->
  <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
    <arg name="gz_args" value="-r -v 4 $(var world)"/>
    <arg name="on_exit_shutdown" value="true"/>
  </include>

  <node pkg="tf2_ros" exec="static_transform_publisher"
        args="0.0 0.0 0.12 0 0 0 base_link laser"
        output="screen"/>

  <!-- Spawn robot model from SDF -->
  <node pkg="ros_gz_sim" exec="create"
        args="-file $(find-pkg-share syncai_demo_gz)/models/model.sdf
             -name diff_pioneer
             -x 5.0 -y 15.0 -z 0.1"
        output="screen" />

  <node pkg="ros_gz_bridge" exec="parameter_bridge"
        args="/cmd_vel@geometry_msgs/msg/Twist]gz.msgs.Twist
              /odom@nav_msgs/msg/Odometry[gz.msgs.Odometry
              /tf@tf2_msgs/msg/TFMessage[gz.msgs.Pose_V
              /clock@rosgraph_msgs/msg/Clock[gz.msgs.Clock
              /scan@sensor_msgs/msg/LaserScan[gz.msgs.LaserScan"
        output="screen"/>

</launch>